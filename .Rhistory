rij <- paste0("r",i,j)
pij_nxt <- paste0("p",(i+1),j)
rij_nxt <- paste0("r",i,(j+1))
nodes <- c(sij)
if(i > 1) nodes <- append(nodes, pij)
if(i < M) nodes <- append(nodes, pij_nxt)
if(j > 1) nodes <- append(nodes, rij)
if(j < N) nodes <- append(nodes, rij_nxt)
t(combn(nodes,2))
})
